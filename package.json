{
  "name": "gridlock-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,blue \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "tsc --noEmit && npm run build -w frontend",
    "test": "vitest run",
    "test:browser": "node tests/map-smoke.mjs",
    "start": "npm run start -w backend",
    "db:build": "python scripts/build_db.py",
    "data:import-example": "python scripts/import_sample.py \"C:\\Users\\jeffr\\Downloads\\OneDrive_2026-09-26\\ShellHacks 2026 - Gridlock\\Projects_Overlaps.xlsx\"",
    "data:import-pdfs": "python scripts/import_project_listings.py",
    "data:enrich-synthetic": "python scripts/enrich_synthetic_test_data.py",
    "data:refresh": "npm run data:import-example && npm run data:import-pdfs && npm run data:enrich-synthetic && npm run db:build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
